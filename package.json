{
  "name": "hackshield-next",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:server": "tsx watch server/index.ts",
    "build": "prisma generate && next build",
    "vercel-build": "prisma migrate resolve --rolled-back 20261107010000_add_prisma_registration_storage || true; prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "start:server": "tsx server/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "typecheck": "prisma generate && tsc --noEmit",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:contracts": "vitest run tests/openapi.contract.test.ts",
    "test:api-client": "vitest run tests/api.contract.test.ts",
    "test:frontend": "vitest run tests/frontend",
    "test:backend": "vitest run tests/server",
    "test:database": "vitest run tests/database",
    "test:registration": "vitest run tests/frontend/registration-flow.test.tsx tests/server/mini-sprint-registration.integration.test.ts tests/database/mini-sprint-repository.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "framer-motion": "^14.10.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intersection-observer": "^11.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
