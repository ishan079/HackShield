# HackShield Next.js Frontend - Environment Variables

# Direct PostgreSQL URL used by Prisma CLI migrations
DATABASE_URL=postgres://hackshield:hackshield@localhost:5432/hackshield

# Optional pooled URL used by application traffic in Vercel Functions
DATABASE_URL_POOLED=
HOST=0.0.0.0
PORT=5001
LOG_LEVEL=info

# Browser client path; keep this relative to use native Next.js API routes
NEXT_PUBLIC_API_URL=/api/v1

# CTFd Instance URL (IIT Patna)
NEXT_PUBLIC_CTFD_URL=https://ctf.iitp.ac.in

# WhatsApp Community Join Link
NEXT_PUBLIC_WHATSAPP_LINK=https://chat.whatsapp.com/Kk4EPaNeHkp8oNQZ8O0ZR7
