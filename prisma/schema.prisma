generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MiniSprint {
  id               String                      @id
  title            String
  status           String
  statusColor      String                      @map("status_color")
  startsAt         DateTime                    @map("starts_at")
  endsAt           DateTime                    @map("ends_at")
  durationMinutes  Int                         @map("duration_minutes")
  challengeCount   Int                         @map("challenge_count")
  difficulty       String
  format           String
  reward           String
  description      String
  registrationOpen Boolean                     @default(false) @map("registration_open")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @default(now()) @map("updated_at")
  registrations    MiniSprintRegistration[]

  @@index([startsAt])
  @@map("mini_sprints")
}

model MiniSprintRegistration {
  emailNormalized String     @id @map("email_normalized")
  id              String     @default(uuid()) @map("id") @db.Uuid
  sprintId        String     @map("sprint_id")
  fullName        String?    @map("full_name")
  rollNumber      String?    @map("roll_number")
  subject         String?
  semester        Int?
  mobileNumber    String?    @map("mobile_number")
  email           String
  pwnUsername     String     @map("pwn_username")
  status          String
  registeredAt    DateTime   @default(now()) @map("registered_at")
  sprint          MiniSprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, pwnUsername])
  @@unique([sprintId, mobileNumber])
  @@map("mini_sprint_registrations")
}

model PwnCollegeHacker {
  userId            String                       @id @map("user_id")
  username          String?
  firstSeenAt       DateTime                     @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime                     @default(now()) @map("last_seen_at")
  scoreboardEntries PwnCollegeScoreboardEntry[]
  solves            PwnCollegeSolve[]

  @@map("pwn_college_hackers")
}

model PwnCollegeScoreboardEntry {
  windowDays Int              @map("window_days")
  userId     String           @map("user_id")
  rank       Int
  solves     Int
  fetchedAt  DateTime         @map("fetched_at")
  hacker     PwnCollegeHacker @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@id([windowDays, userId])
  @@index([windowDays, rank])
  @@map("pwn_college_scoreboard_entries")
}

model PwnCollegeSolve {
  userId      String           @map("user_id")
  module      String
  challenge   String
  solvedAt    DateTime         @map("solved_at")
  firstSeenAt DateTime         @default(now()) @map("first_seen_at")
  hacker      PwnCollegeHacker @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@id([userId, module, challenge, solvedAt])
  @@index([solvedAt])
  @@map("pwn_college_solves")
}

model PwnCollegeSyncJob {
  id           String    @id
  source       String
  status       String
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  receivedRows Int?      @map("received_rows")
  retainedRows Int?      @map("retained_rows")
  errorCode    String?   @map("error_code")

  @@index([source, startedAt])
  @@map("pwn_college_sync_jobs")
}
