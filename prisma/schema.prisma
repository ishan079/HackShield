generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SprintStatus {
  REGISTRATION_OPEN
  REGISTRATION_OPENING_SOON
  REGISTRATION_CLOSED
  LIVE
  COMPLETED
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
}

model MiniSprint {
  id               String                   @id
  title            String
  status           SprintStatus
  statusColor      String                   @map("status_color")
  startsAt         DateTime                 @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime                 @map("ends_at") @db.Timestamptz(3)
  durationMinutes  Int                      @map("duration_minutes")
  challengeCount   Int                      @map("challenge_count")
  difficulty       String
  format           String
  reward           String
  description      String
  registrationOpen Boolean                  @default(false) @map("registration_open")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  registrations    MiniSprintRegistration[]

  @@index([startsAt])
  @@map("mini_sprints")
}

model MiniSprintRegistration {
  id                    String             @id @default(uuid()) @db.Uuid
  sprintId              String             @map("sprint_id")
  email                 String
  emailNormalized       String             @map("email_normalized")
  pwnUsername           String             @map("pwn_username")
  pwnUsernameNormalized String             @map("pwn_username_normalized")
  status                RegistrationStatus @default(CONFIRMED)
  registeredAt          DateTime           @default(now()) @map("registered_at") @db.Timestamptz(3)
  sprint                MiniSprint         @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, emailNormalized])
  @@unique([sprintId, pwnUsernameNormalized])
  @@map("mini_sprint_registrations")
}
